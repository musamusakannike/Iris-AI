{
  "expo": {
    "name": "Iris AI",
    "slug": "iris-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "irisai",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Iris AI needs camera access to see and describe your surroundings in real-time.",
        "NSMicrophoneUsageDescription": "Iris AI needs microphone access to listen to your voice questions.",
        "NSSpeechRecognitionUsageDescription": "Iris AI needs speech recognition to transcribe your spoken queries."
      },
      "bundleIdentifier": "com.codiac.irisai"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false,
      "package": "com.codiac.irisai"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Iris AI needs camera access to see and describe your surroundings in real-time.",
          "microphonePermission": "Iris AI needs microphone access to listen to your voice questions."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Iris AI needs microphone access to listen to your voice questions.",
          "speechRecognitionPermission": "Iris AI needs speech recognition to transcribe your spoken queries."
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-image",
      "expo-secure-store",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8157473c-2d27-419b-bc26-7e5490acec36"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8157473c-2d27-419b-bc26-7e5490acec36"
    }
  }
}
