# Server Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/lumina_eye

# CORS Configuration
CORS_ORIGIN=*

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_IN=7d

# AI Provider Selection: 'ollama' | 'gemini' | 'openai-compatible' | 'mock'
AI_PROVIDER=ollama

# Self-Hosted Ollama VLM Configuration (Moondream 2, Qwen2.5-VL)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=moondream

# Optional: OpenAI-Compatible / vLLM / SGLang Endpoint
OPENAI_COMPATIBLE_BASE_URL=http://your-vps-ip:8000/v1
OPENAI_COMPATIBLE_API_KEY=your_optional_vlm_token
OPENAI_COMPATIBLE_MODEL=moondream

# Google Gemini AI Configuration (Fallback / Alternative)
GEMINI_API_KEY=your_google_genai_api_key_here

# Expo Push Notification Configuration
EXPO_ACCESS_TOKEN=your_expo_access_token_optional
